extrafont::font_import()
df = read.csv("TISLR.csv", sep = ";")
# Drop Accessibility column
df$IS_Score_Auto2 <- NULL
# Recoding
df$ref_type1 <- with(df, case_when(
GTR1 %in% c("Bare noun", "Point noun", "Noun Point",
"Fingerspelled noun", "CL noun", "Noun CL") ~ "NOM",
GTR1 %in% c("Constructed action", "Plain verb", "Person agreement verb") ~ "NULL",
GTR1 %in%  c("Whole entity CL", "Body part CL",
"SASS - Tracing", "SASS - Static") ~ "CL",
T ~ "PRO"))
df$ref_type2 <- ifelse(df$GTR1 %in% c("Bare noun", "Point noun", "Noun Point","Fingerspelled noun", "CL noun", "Noun CL"), "NOM",
ifelse(df$GTR1 %in% c("Constructed action", "Constructed Action"), "CA",
ifelse(df$GTR1 %in% c("Plain verb","Person agreement verb"), "VERB",
ifelse(df$GTR1 %in% c("Whole entity CL"), "WCL",
ifelse(df$GTR1 %in% c("Body part CL"), "BPCL",
ifelse(df$GTR1 %in% c("SASS - Tracing", "SASS - Static"), "SASS", "PRO"))))))
df$Nativeness <- df$Nativeness %>% recode('1' = "Native", '0' = "Late")
df$Accessibility %<>% as.numeric()
# Native Signers
df_native = df %>% subset(Nativeness == "Native")
df_analysis_native = df_native %>% select(Subject, Nativeness, Discourse, ref_type2, Accessibility, Narrative)
df_analysis_native$ref_type2 <- factor(df_analysis_native$ref_type2, levels = c("NOM", "SASS","PRO","BPCL", "WCL","CA", "VERB"))
# Discourse plot
df_analysis = df %>% select(Subject, Nativeness, Discourse, ref_type1, Accessibility, Narrative)
df_analysis$ref_type1 <- factor(df_analysis$ref_type1, levels = c("NOM", "PRO","CL","NULL"))
# use ggplot2 to plot accessibility with discourse
p3 <- ggplot(df_analysis, aes(x = ref_type1, y = Accessibility)) +
scale_y_continuous(limits = (c(-2, 5)), breaks = seq(-2,5, by=1)) +
theme(text = element_text(size=25)) +
xlab("REAT Category") +
ylab("Accessibility Score") +
ggthemes::theme_tufte() +
# change legend title to RE Type
labs(color = "REAT Category") +
# make transparent
#geom_point(aes(color = ref_type2), position = position_jitter(width = .2), size = 3) +
geom_jitter(aes(color = ref_type1), position = position_jitter(width = .2), size = 3, alpha = 0.25) +
geom_segment(aes(x = ref_type1, xend = ref_type1, y = Accessibility, yend = Accessibility), position = position_jitter(width = .2), size = 0.5, nudge_y = 0.4) +
facet_wrap(~Discourse, nrow = 1, scales = "free_x")
p3
